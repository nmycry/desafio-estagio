{
  "name": "jhonatanrs/citizens",
  "description": "Cadastro e pesquisa de cidadãos brasileiros em PHP puro.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "ext-mbstring": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "src/Infrastructure/View/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "analyse": "phpstan analyse --memory-limit=512M",
    "cs:check": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix",
    "seed": "php bin/seed.php"
  },
  "config": {
    "sort-packages": true
  }
}
