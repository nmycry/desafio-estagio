# Portas publicadas no host (troque se 8080 ou 3306 já estiverem em uso)
APP_PORT=8080
DB_PORT=3306

# Banco de dados. DB_NAME, DB_TEST_NAME e DB_USER precisam coincidir
# com os nomes usados em database/init/01-schema.sql.
DB_HOST=db
DB_NAME=citizens
DB_TEST_NAME=citizens_test
DB_USER=citizens
DB_PASSWORD=citizens
DB_ROOT_PASSWORD=root

# UID/GID do seu usuário no host (veja com `id -u` e `id -g`)
UID=1000
GID=1000
